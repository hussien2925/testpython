# Copy this file to `.env` (which is gitignored) and fill in the values you
# want. Variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle
# at build time and readable by anyone who downloads the app — treat them
# accordingly (see README's security note about the OpenAI key).

# OpenAI — required for the AI chat interface. Without it the app falls back
# to the offline rule-based parser.
EXPO_PUBLIC_OPENAI_API_KEY=
# Optional overrides. Model must support tool/function calling.
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
# Point at a Proxy Worker/Function if you want to keep the real API key on a
# server. Anything OpenAI-compatible works.
EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1

# RevenueCat public SDK keys (safe to embed; see SUBSCRIPTIONS.md).
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Google Maps — only needed for Android map rendering. iOS uses Apple Maps.
GOOGLE_MAPS_API_KEY=
